# Server Configuration
PORT=8080
ADDR=:8080
API_BASE_URL=http://localhost:8080
API_BASE_PATH=/api/v1
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# Authentication. Leave blank only for local development: the API is then unauthenticated.
# Keys must be >= 16 characters; separate several keys with commas to rotate without downtime.
# Generate one with: openssl rand -hex 32
API_KEY=
# Serve /metrics without the API key (e.g. when Prometheus scrapes over a private network).
METRICS_PUBLIC=false
# Managed API keys (POST /api/v1/auth/keys with the API_KEY above): default and maximum lifetime,
# and how many active keys may exist.
API_KEY_DEFAULT_TTL=720h
API_KEY_MAX_TTL=8760h
MAX_API_KEYS=100
# Serve the Swagger UI at /docs (disable in locked-down production environments).
DOCS_ENABLED=true

# HTTP edge
REQUEST_TIMEOUT=30s
# Comma-separated browser origins allowed by CORS (blank = same-origin only, "*" = any).
CORS_ALLOWED_ORIGINS=
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted (blank = trust none).
TRUSTED_PROXIES=

# Job store. Leave DATABASE_URL empty for the embedded SQLite store in DATA_DIR (single instance).
# Set a PostgreSQL URL to run several replicas against one shared store, e.g.
#   DATABASE_URL=postgres://pipeline:secret@db.internal:5432/pipeline?sslmode=require
# With several replicas, EXPORT_DIR must be shared storage (NFS/EFS/RWX volume) mounted on all of them.
DATABASE_URL=
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
# Replica identity (default: hostname-random) and how long a replica may go silent before its
# running jobs are failed by the others.
INSTANCE_ID=
JOB_LEASE=30s

# Storage and Export Paths
# DATA_DIR holds the SQLite job store (pipeline.db). Every export/DLQ path must be inside EXPORT_DIR.
DATA_DIR=data
EXPORT_DIR=exports
# Comma-separated directories that local file sources may read from (sandbox).
INPUT_DIRS=samples,inputs
# Allow HTTP sources on private/loopback networks (local development only).
ALLOW_PRIVATE_SOURCES=false

# Concurrency & Worker Limits
MAX_ACTIVE_JOBS=10
DEFAULT_TIMEOUT_SECONDS=300
DEFAULT_VALIDATION_WORKERS=4
DEFAULT_TRANSFORM_WORKERS=4
DEFAULT_BUFFER_SIZE=64

# Per-job limits (requests above these are rejected with 400)
MAX_WORKERS_PER_STAGE=64
MAX_BUFFER_SIZE=10000
MAX_BATCH_SIZE=10000
MAX_JOB_TIMEOUT_SECONDS=3600
MAX_SOURCES_PER_JOB=16
MAX_EXPORTS_PER_JOB=8
MAX_AGGREGATION_WORKERS=16
# Maximum bytes read from a single source (file or HTTP body); larger sources fail.
MAX_SOURCE_BYTES=1073741824

# Data lifecycle: finished jobs (and their exports) older than this are purged hourly; 0 keeps forever.
JOB_RETENTION=168h

# Graceful shutdown: time allowed to cancel running jobs and persist their state
SHUTDOWN_TIMEOUT=25s

# Rate Limiting & Request Constraints
RATE_LIMIT_RPS=50.0
RATE_LIMIT_BURST=100
MAX_REQUEST_BODY_BYTES=2097152

# Logging Observability
LOG_LEVEL=info
LOG_FORMAT=text

