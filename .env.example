# Server Configuration
PORT=8080
ADDR=:8080
API_BASE_URL=http://localhost:8080
API_BASE_PATH=/api/v1
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# Authentication (Optional - leave blank to disable)
API_KEY=

# Storage and Export Paths
# DATA_DIR holds the SQLite job store (pipeline.db). Every export/DLQ path must be inside EXPORT_DIR.
DATA_DIR=data
EXPORT_DIR=exports
# Comma-separated directories that local file sources may read from (sandbox).
INPUT_DIRS=samples,inputs
# Allow HTTP sources on private/loopback networks (local development only).
ALLOW_PRIVATE_SOURCES=false

# Concurrency & Worker Limits
MAX_ACTIVE_JOBS=10
DEFAULT_TIMEOUT_SECONDS=300
DEFAULT_VALIDATION_WORKERS=4
DEFAULT_TRANSFORM_WORKERS=4
DEFAULT_BUFFER_SIZE=64

# Per-job limits (requests above these are rejected with 400)
MAX_WORKERS_PER_STAGE=64
MAX_BUFFER_SIZE=10000
MAX_BATCH_SIZE=10000
MAX_JOB_TIMEOUT_SECONDS=3600
MAX_SOURCES_PER_JOB=16
MAX_EXPORTS_PER_JOB=8

# Graceful shutdown: time allowed to cancel running jobs and persist their state
SHUTDOWN_TIMEOUT=25s

# Rate Limiting & Request Constraints
RATE_LIMIT_RPS=50.0
RATE_LIMIT_BURST=100
MAX_REQUEST_BODY_BYTES=2097152

# Logging Observability
LOG_LEVEL=info
LOG_FORMAT=text

