#!/bin/sh
# .githooks/pre-commit
# Enforces code formatting, static analysis, and test verification before commit.

set -e

echo "🔍 [pre-commit] Checking staged Go files..."

# Find all staged .go files (excluding vendor or generated if any)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    # 1. Formatting check & auto-format
    if command -v gofumpt >/dev/null 2>&1; then
        echo "🧹 [pre-commit] Running gofumpt (stricter gofmt)..."
        echo "$STAGED_GO_FILES" | xargs gofumpt -w
        echo "$STAGED_GO_FILES" | xargs git add
    elif command -v gofmt >/dev/null 2>&1; then
        echo "🧹 [pre-commit] Running gofmt..."
        echo "$STAGED_GO_FILES" | xargs gofmt -w
        echo "$STAGED_GO_FILES" | xargs git add
    fi
fi

# 2. Static Analysis: go vet
echo "🔎 [pre-commit] Running go vet..."
if ! go vet ./...; then
    echo "❌ [pre-commit] 'go vet' found issues. Please resolve them before committing."
    exit 1
fi

# 3. Linter: golangci-lint (if installed)
if command -v golangci-lint >/dev/null 2>&1; then
    echo "🔎 [pre-commit] Running golangci-lint..."
    if ! golangci-lint run --fast; then
        echo "❌ [pre-commit] 'golangci-lint' reported errors."
        exit 1
    fi
fi

# 4. Fast Unit Tests
echo "🧪 [pre-commit] Running fast tests..."
if ! go test -short ./...; then
    echo "❌ [pre-commit] Unit tests failed. Fix tests before committing."
    exit 1
fi

echo "✅ [pre-commit] All pre-commit checks passed successfully!"
exit 0

