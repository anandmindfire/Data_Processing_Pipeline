{
  "sources": [
    {"type":"csv","name":"employees-csv","path":"samples/input.csv"},
    {"type":"json","name":"employees-json","path":"samples/input.json"}
  ],
  "rules": [
    {"field":"name","type":"string","required":true,"normalize":"trim"},
    {"field":"department","type":"string","required":true,"normalize":"lower"},
    {"field":"salary","type":"number","required":true,"min":0}
  ],
  "aggregations": [
    {"group_by":"department","field":"salary","operation":"count","name":"employee_count"},
    {"group_by":"department","field":"salary","operation":"sum","name":"salary_total"},
    {"group_by":"department","field":"salary","operation":"avg","name":"salary_average"}
  ],
  "exports": [{"type":"json","path":"exports/employees.json"},{"type":"csv","path":"exports/employees.csv"}],
  "validation_workers":4,"transform_workers":4,"buffer_size":64,"timeout_seconds":60
}
