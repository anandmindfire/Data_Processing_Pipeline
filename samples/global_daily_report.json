{
  "sources": [
    {
      "type": "csv",
      "name": "population-csv",
      "url": "https://people.sc.fsu.edu/~jburkardt/data/csv/hw_200.csv"
    },
    {
      "type": "http",
      "name": "crypto-prices",
      "url": "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&per_page=20",
      "format": "json",
      "headers": { "Accept": "application/json" }
    },
    {
      "type": "http",
      "name": "weather-now",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=20&longitude=85&current_weather=true",
      "format": "json",
      "records_path": "current_weather"
    }
  ],
  "rules": [
    { "field": "Height(Inches)", "type": "number", "min": 0, "rename": "height_in" },
    { "field": "Weight(Pounds)", "type": "number", "min": 0, "rename": "weight_lb" },
    { "field": "current_price", "type": "number", "min": 0, "rename": "price_usd" },
    { "field": "price_change_percentage_24h", "type": "number", "rename": "change_24h_pct" },
    { "field": "symbol", "type": "string", "normalize": "upper" },
    { "field": "temperature", "type": "number", "min": -90, "max": 60, "rename": "temperature_c" },
    { "field": "windspeed", "type": "number", "min": 0, "rename": "windspeed_kmh" }
  ],
  "aggregations": [
    { "group_by": "_source", "field": "_source", "operation": "count", "name": "records_per_source" },
    { "field": "height_in", "operation": "avg", "name": "avg_height_in" },
    { "field": "weight_lb", "operation": "avg", "name": "avg_weight_lb" },
    { "field": "price_usd", "operation": "sum", "name": "total_price_usd" },
    { "field": "change_24h_pct", "operation": "avg", "name": "avg_crypto_change_24h_pct" },
    { "field": "change_24h_pct", "operation": "max", "name": "best_crypto_change_24h_pct" },
    { "field": "temperature_c", "operation": "max", "name": "temperature_c" },
    { "field": "windspeed_kmh", "operation": "max", "name": "windspeed_kmh" }
  ],
  "exports": [
    { "type": "json", "path": "global_daily_report.json" },
    { "type": "sqlite", "path": "global_daily_report.db" }
  ],
  "include_source_field": true,
  "validation_workers": 4,
  "transform_workers": 4,
  "aggregation_workers": 2,
  "timeout_seconds": 60,
  "dlq_path": "global_daily_report.dlq.json"
}
