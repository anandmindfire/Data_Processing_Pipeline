{
  "openapi": "3.0.3",
  "info": {
    "title": "Data Processing Pipeline REST API",
    "version": "1.0.0",
    "description": "High-performance, asynchronous concurrent data processing engine in idiomatic Go. Ingests heterogeneous data (CSV, JSON, HTTP REST APIs), validates and transforms records, calculates statistical group aggregations, and persists results with real-time observability.",
    "contact": {
      "name": "Anand K",
      "email": "anand.k@mindfiresolutions.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Pipelines",
      "description": "Pipeline job lifecycle management, progress tracking, and results retrieval"
    },
    {
      "name": "Observability",
      "description": "System health checks and Prometheus metrics exposition"
    },
    {
      "name": "API Keys",
      "description": "Issue, list and revoke expiring API keys (admin only)"
    }
  ],
  "paths": {
    "/api/v1/pipelines": {
      "post": {
        "tags": [
          "Pipelines"
        ],
        "summary": "Submit and trigger a pipeline job",
        "description": "Submits a new data processing pipeline specification and begins asynchronous execution.",
        "operationId": "createPipelineJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              },
              "example": {
                "sources": [
                  {
                    "type": "csv",
                    "name": "employees-csv",
                    "path": "samples/input.csv"
                  },
                  {
                    "type": "json",
                    "name": "contractors-json",
                    "path": "samples/input.json"
                  }
                ],
                "rules": [
                  {
                    "field": "name",
                    "type": "string",
                    "required": true,
                    "normalize": "trim"
                  },
                  {
                    "field": "department",
                    "type": "string",
                    "required": true,
                    "normalize": "lower"
                  },
                  {
                    "field": "salary",
                    "type": "number",
                    "required": true,
                    "min": 0
                  }
                ],
                "aggregations": [
                  {
                    "group_by": "department",
                    "field": "salary",
                    "operation": "count",
                    "name": "employee_count"
                  },
                  {
                    "group_by": "department",
                    "field": "salary",
                    "operation": "sum",
                    "name": "salary_total"
                  },
                  {
                    "group_by": "department",
                    "field": "salary",
                    "operation": "avg",
                    "name": "salary_average"
                  }
                ],
                "exports": [
                  {
                    "type": "json",
                    "path": "exports/results.json"
                  },
                  {
                    "type": "csv",
                    "path": "exports/results.csv"
                  }
                ],
                "validation_workers": 4,
                "transform_workers": 4,
                "buffer_size": 64,
                "timeout_seconds": 60
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Pipeline job accepted and queued for execution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid spec: unknown type/operation, path outside INPUT_DIRS/EXPORT_DIR, or a limit exceeded. All problems are reported together. Unknown fields are rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Capacity reached (MAX_ACTIVE_JOBS) or server shutting down; retry later",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API key (when API_KEY is set)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit exceeded; see Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body larger than MAX_REQUEST_BODY_BYTES"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content-Type is not application/json"
          }
        }
      },
      "get": {
        "tags": [
          "Pipelines"
        ],
        "summary": "List all pipeline jobs",
        "description": "Lists jobs newest first. The total number of matching jobs is returned in the X-Total-Count header.",
        "operationId": "listPipelineJobs",
        "responses": {
          "200": {
            "description": "List of pipeline jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            },
            "headers": {
              "X-Total-Count": {
                "description": "Total matching jobs",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging or status parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid API key (when API_KEY is set)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit exceeded; see Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/JobStatus"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/v1/pipelines/{id}": {
      "get": {
